<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context="com.t4paN.AVA.MainActivity">

    <item
        android:id="@+id/action_toggle_unlock"
        android:orderInCategory="100"
        android:title="Εκκίνηση με ξεκλείδωμα: ΟΧΙ"
        app:showAsAction="never" />

    <item
        android:id="@+id/action_toggle_fastmode"
        android:orderInCategory="99"
        android:title="Γρήγορη λειτουργία: ΝΑΙ"
        app:showAsAction="never" />

    <item
        android:id="@+id/action_toggle_autocall"
        android:orderInCategory="101"
        android:title="Αυτόματη κλήση: ΝΑΙ"
        app:showAsAction="never" />

    <item
        android:id="@+id/action_toggle_online"
        android:orderInCategory="97"
        android:title="Αναγνώριση: Whisper"
        app:showAsAction="never" />

    <!-- The escape hatch for a phone too slow to carry Whisper, which is a per-device
         question AVA deliberately does not try to answer for the caregiver: the notice
         asks them to try it a few times with the network off and decide. Turning this
         off means no offline engine at all — the call button stops working without a
         network, which is why the notice spells that out rather than just advising
         the switch. -->
    <item
        android:id="@+id/action_toggle_offline"
        android:orderInCategory="98"
        android:title="Λειτουργία χωρίς ίντερνετ: ΝΑΙ"
        app:showAsAction="never" />

    <item
        android:id="@+id/action_download_model"
        android:orderInCategory="99"
        android:title="Λήψη μοντέλου ομιλίας"
        app:showAsAction="never" />

    <item
        android:id="@+id/action_manage_stations"
        android:orderInCategory="90"
        android:title="Σταθμοί ραδιοφώνου"
        app:showAsAction="never" />

    <!-- Titles carry their state as ΝΑΙ / ΟΧΙ: both are three characters, so the
         row length no longer changes as a setting is toggled and the ellipsis
         stops moving around when the popup truncates at high display zoom. A
         real switch widget needs a real settings screen (road2release.md §1),
         which an overflow popup cannot be. -->

    <!-- The template's do-nothing "Settings" item was removed 2026-08-21 along
         with the VoIP entries: it was the fifth English label and tapping it did
         literally nothing (R.id.action_settings -> true).

         VoIP calibration, VoIP diagnostics and the Direct-VoIP-call toggle were
         removed 2026-08-21. They all served the calibration + auto-click path,
         which contact data-row calling replaced; direct calling is now the only
         path and defaults to on. VoIPCalibrationActivity itself is kept for now
         because accessibility_service_config.xml still names it as its
         settingsActivity, and that config ships with the debug-only service. -->
</menu>