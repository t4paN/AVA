<?xml version="1.0" encoding="utf-8"?>
<!-- activity_voip_calibration.xml -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A1A">

    <!-- App Selection State -->
    <LinearLayout
        android:id="@+id/appListContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/voip_calibration_select_app"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <ListView
            android:id="@+id/appListView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="#333333"
            android:dividerHeight="1dp" />

    </LinearLayout>

    <!-- Position Selection State -->
    <FrameLayout
        android:id="@+id/calibrationContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <!-- Screenshot - full screen, tappable -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/screenshotImageView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitStart"
                android:adjustViewBounds="true" />

            <!-- Purple dot overlay -->
            <View
                android:id="@+id/purpleDotView"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/purple_dot"
                android:visibility="gone"
                android:elevation="10dp" />

        </FrameLayout>

        <!-- Draggable Controls Panel -->
        <LinearLayout
            android:id="@+id/controlsPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:background="#DD2A2A2A"
            android:elevation="8dp">

            <!-- Drag Handle -->
            <View
                android:id="@+id/dragHandle"
                android:layout_width="60dp"
                android:layout_height="6dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/drag_handle_bg" />

            <!-- Instruction -->
            <TextView
                android:id="@+id/instructionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/voip_calibration_tap_instruction"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textAlignment="center"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="12dp" />

            <!-- Pick Screenshot Button -->
            <Button
                android:id="@+id/pickScreenshotButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginHorizontal="16dp"
                android:text="Επιλογή νέου screenshot"
                android:textSize="14sp"
                android:backgroundTint="#666666"
                android:layout_marginBottom="12dp" />

            <!-- Wait time -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/voip_calibration_wait_time"
                    android:textColor="#CCCCCC"
                    android:textSize="16sp"
                    android:layout_marginEnd="12dp" />

                <Button
                    android:id="@+id/waitTimeMinus"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="-"
                    android:textSize="24sp"
                    android:backgroundTint="#555555" />

                <EditText
                    android:id="@+id/waitTimeInput"
                    android:layout_width="60dp"
                    android:layout_height="48dp"
                    android:inputType="number"
                    android:textColor="#FFFFFF"
                    android:textAlignment="center"
                    android:textSize="20sp"
                    android:background="#333333"
                    android:layout_marginHorizontal="8dp" />

                <Button
                    android:id="@+id/waitTimePlus"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="+"
                    android:textSize="24sp"
                    android:backgroundTint="#555555" />

            </LinearLayout>

            <!-- Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:paddingBottom="16dp">

                <Button
                    android:id="@+id/cancelButton"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:text="@string/voip_calibration_cancel"
                    android:textSize="16sp"
                    android:backgroundTint="#666666"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/addStepButton"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:text="+"
                    android:textSize="28sp"
                    android:backgroundTint="#2196F3"
                    android:visibility="gone"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/saveButton"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:text="@string/voip_calibration_save"
                    android:textSize="16sp"
                    android:backgroundTint="#4CAF50"
                    android:layout_marginStart="8dp" />

            </LinearLayout>

        </LinearLayout>

    </FrameLayout>

</FrameLayout>
