<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Debug-only declaration of the legacy auto-click AccessibilityService.

      Kept OUT of the release bundle on purpose. Play triggers its accessibility
      declaration review off the <service> entry below regardless of whether
      anything uses it at runtime, so a disabled-but-declared service still costs
      the full review. Normal VoIP calling no longer needs it — VoIPDirectCall
      fires the contact's own messenger call row — so release ships without it,
      while dogfood builds keep the fallback available.
    -->
    <application>
        <service
            android:name=".AVAAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>

</manifest>
